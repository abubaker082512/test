{
  "version": 2,
  "routes": [
    {
      "src": "^/sg/callback/?$",
      "dest": "/api/softaggregator/callback"
    },
    {
      "src": "^/sg/(.*)$",
      "dest": "/api/softaggregator/$1"
    },
    {
      "src": "^/gold_api/(.*)$",
      "dest": "/api/gold_api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
