<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Native Top Bar for Game Stage -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/headerBg"
        android:paddingHorizontal="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_back_lobby"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="⬅ Lobby"
                android:textColor="@color/textColor"
                android:backgroundTint="@color/cardColor"
                android:textSize="11sp"
                android:textStyle="bold"
                style="@style/Widget.MaterialComponents.Button" />

            <TextView
                android:id="@+id/tv_game_stage_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="🎮 Super Ace"
                android:textColor="@color/accentColor"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_game_stage_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_wallet_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="🎮 Rs 10,000"
                android:textColor="@color/accentColor"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_reload_game"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:text="🔄"
                android:textColor="@color/textColor"
                android:backgroundTint="@color/cardColor"
                android:padding="0dp"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Main Game Container -->
    <FrameLayout
        android:id="@+id/game_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/game_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/game_loading_progress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accentColor" />
    </FrameLayout>
</LinearLayout>
