<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="148dp"
    android:layout_margin="3dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/cardColor"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Game Cover Image -->
        <ImageView
            android:id="@+id/img_game_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/app_logo"
            android:contentDescription="Game Cover" />

        <!-- Provider Badge Tag (Top Right) -->
        <TextView
            android:id="@+id/tv_provider_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="4dp"
            android:background="@drawable/bg_provider_tag"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:text="JILI"
            android:textColor="#000000"
            android:textSize="8.5sp"
            android:textStyle="bold" />

        <!-- Hot/Top Badge (Top Left) -->
        <TextView
            android:id="@+id/tv_badge_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_margin="4dp"
            android:background="@drawable/bg_provider_tag"
            android:backgroundTint="#FF3D00"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:text="🔥 HOT"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold" />

        <!-- Bottom Capsule Title Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_alignParentBottom="true"
            android:layout_margin="4dp"
            android:background="@drawable/bg_pill_capsule"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="4dp">

            <TextView
                android:id="@+id/tv_game_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Super Ace"
                android:textColor="#000000"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
